---
// Article page, in the personal aesthetic (Me layout, --me-* tokens, macOS
// type). Root route = PT; localized copies live under [lang]/journal/[slug].
// Body/figures/reading-time/share logic is preserved from the studio version;
// only the chrome and styling changed.
import Me from '../../layouts/Me.astro';
import { Image } from 'astro:assets';
import { articles } from '../../data/journal.js';
import { getLocale, homePath } from '../../i18n/index.js';
import { getPages } from '../../i18n/pages.js';
import { postBlocks } from '../../i18n/posts.js';

const locale = getLocale(Astro);
const P = getPages(locale);

import gumeEstante from '../../assets/journal/gume-estante.png';
import gumeContribuidores from '../../assets/journal/gume-contribuidores.png';
import gumeOQueFalta from '../../assets/journal/gume-o-que-falta.png';
const FIGURES = {
  'gume-estante': gumeEstante,
  'gume-contribuidores': gumeContribuidores,
  'gume-o-que-falta': gumeOQueFalta,
};

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props;
const jp = P.journalPosts[article.slug] ?? {};
const artTitle = jp.title ?? article.title;
const artDek = jp.dek ?? article.dek;
const blocks = postBlocks[locale]?.[article.slug] ?? article.blocks;
const translated = Boolean(postBlocks[locale]?.[article.slug]) || locale === 'en';

const words = blocks
  .flatMap((b) => [b.html, b.caption, ...(b.items || [])])
  .filter(Boolean)
  .join(' ')
  .replace(/<[^>]+>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const read = Math.max(1, Math.round(words / 200)) + ' min';

const site = 'https://www.4real.ventures';
const url = `${site}${homePath(locale)}journal/${article.slug}/`.replace('//journal', '/journal');
const e = encodeURIComponent;
const shareX = `https://twitter.com/intent/tweet?text=${e(artTitle)}&url=${e(url)}`;
const shareLI = `https://www.linkedin.com/sharing/share-offsite/?url=${e(url)}`;
const shareMail = `mailto:?subject=${e(artTitle)}&body=${e(url)}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.dek,
  datePublished: article.date,
  dateModified: article.date,
  author: { '@type': 'Person', name: 'Gabriel Olegário' },
  publisher: { '@type': 'Person', name: 'Gabriel Olegário' },
  image: `${site}/og-image.png`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  url,
};
---
<Me pageTitle={`${artTitle} · Gabriel Olegário`} pageDesc={artDek}>
  <div class="art-progress" id="artProgress" aria-hidden="true"></div>

  <article class="art">
    <a class="art__back" href={homePath(locale)}><span aria-hidden="true">←</span> Gabriel Olegário</a>

    <header class="art__head">
      {article.kicker && <p class="art__kicker">{article.kicker}</p>}
      <h1 class="art__title">{artTitle}</h1>
      <p class="art__dek">{artDek}</p>
      {!translated && <p class="art__orig">{P.chrome.origNote}</p>}
      <div class="art__byline">
        <span>{article.author}</span>
        <span class="art__dot" aria-hidden="true">·</span>
        <span>{article.dateLabel}</span>
        <span class="art__dot" aria-hidden="true">·</span>
        <span>{read}</span>
      </div>
    </header>

    {article.cover && (
      <img class="art__cover" src={article.cover} alt={article.coverAlt ?? ''} loading="eager" />
    )}

    <div class="art__body">
      {blocks.map((b) =>
        b.t === 'p' ? (
          <p class={'art__p' + (b.drop ? ' has-drop' : '')} set:html={b.html} />
        ) : b.t === 'h2' ? (
          <h2 class="art__h2" id={b.id} set:html={b.html} />
        ) : b.t === 'pull' ? (
          <p class={'art__pull' + (b.lime ? ' is-accent' : '')} set:html={b.html} />
        ) : b.t === 'list' ? (
          <ul class="art__list">
            {b.items.map((it) => (
              <li class="art__li"><span set:html={it} /></li>
            ))}
          </ul>
        ) : b.t === 'figure' && FIGURES[b.img] ? (
          <figure class="art__fig">
            <Image
              class="art__fig-img"
              src={FIGURES[b.img]}
              alt={b.alt}
              widths={[720, 1180]}
              sizes="(max-width: 800px) 100vw, 720px"
              format="webp"
              quality={74}
              loading="lazy"
              decoding="async"
            />
            {b.caption && <figcaption class="art__fig-cap" set:html={b.caption} />}
          </figure>
        ) : b.t === 'links' ? (
          <div class="art__links">
            {b.items.map((l) => (
              <a class="art__link" href={l.href} target="_blank" rel="noopener">
                <span class="art__link-label">{l.label}</span>
                <span class="art__link-val">{l.value}</span>
                <span class="art__link-arr" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        ) : b.t === 'note' ? (
          <p class="art__note" set:html={b.html} />
        ) : b.t === 'divider' ? (
          <div class="art__div" aria-hidden="true"><span>/</span></div>
        ) : b.t === 'signoff' ? (
          <p class="art__signoff" set:html={b.html} />
        ) : null
      )}
    </div>

    <footer class="art__foot">
      <a class="art__back" href={homePath(locale)}><span aria-hidden="true">←</span> Gabriel Olegário</a>
      <nav class="art__share" aria-label="Share">
        <a href={shareX} target="_blank" rel="noopener">X</a>
        <a href={shareLI} target="_blank" rel="noopener">LinkedIn</a>
        <a href={shareMail}>Email</a>
      </nav>
    </footer>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
</Me>

<style>
  .art-progress{ position:fixed; top:0; left:0; height:3px; width:0; background:var(--me-accent); z-index:70; transition:width .1s linear; }

  .art{ max-width:720px; margin:0 auto; padding:calc(46px + clamp(24px,5vh,52px)) clamp(20px,5vw,32px) 110px; }

  .art__back{ display:inline-block; font-family:var(--font-ui); font-size:13px; font-weight:600; color:var(--me-muted); }
  .art__back:hover{ color:var(--me-ink-strong); }

  .art__head{ margin-top:clamp(24px,5vh,44px); }
  .art__kicker{ font-family:var(--font-ui); font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--me-accent); }
  .art__title{ margin-top:12px; font-family:var(--font-ui); font-size:clamp(30px,5vw,46px); font-weight:700; letter-spacing:-.025em; line-height:1.05; color:var(--me-ink-strong); }
  .art__dek{ margin-top:16px; font-size:clamp(17px,2vw,20px); line-height:1.5; color:var(--me-muted); max-width:52ch; }
  .art__orig{ margin-top:14px; font-family:var(--font-ui); font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--me-faint); }
  .art__byline{ margin-top:20px; display:flex; align-items:center; gap:8px; font-family:var(--font-ui); font-size:13px; color:var(--me-faint); }
  .art__byline span:first-child{ color:var(--me-ink); font-weight:600; }

  .art__cover{ width:100%; height:auto; margin:clamp(28px,5vh,44px) 0 0; border-radius:14px; border:1px solid var(--me-line); display:block; }

  .art__body{ margin-top:clamp(28px,5vh,44px); }
  .art__p{ font-size:17.5px; line-height:1.72; color:var(--me-ink); margin:0 0 1.3em; }
  .art__p.has-drop::first-letter{ font-family:var(--font-ui); font-weight:800; color:var(--me-accent); font-size:3em; line-height:.72; float:left; margin:.06em .12em 0 0; }

  .art__body :global(a){ color:var(--me-ink-strong); text-decoration:underline; text-decoration-color:var(--me-line-strong); text-underline-offset:.2em; }
  .art__body :global(a):hover{ color:var(--me-accent); text-decoration-color:var(--me-accent); }
  .art__body :global(strong){ color:var(--me-ink-strong); font-weight:650; }
  .art__body :global(.hl){ color:var(--me-accent); font-weight:600; }
  .art__body :global(.slash){ color:var(--me-accent-2); font-weight:700; }

  .art__h2{ margin:clamp(40px,6vh,64px) 0 clamp(14px,2vh,22px); font-family:var(--font-ui); font-size:clamp(21px,2.6vw,28px); font-weight:700; letter-spacing:-.02em; line-height:1.15; color:var(--me-ink-strong); }

  .art__pull{ margin:clamp(32px,5vh,52px) 0; font-family:var(--font-ui); font-size:clamp(22px,3vw,30px); font-weight:700; letter-spacing:-.02em; line-height:1.18; color:var(--me-ink-strong); }
  .art__pull.is-accent{ color:var(--me-accent); }

  .art__list{ list-style:none; margin:0 0 1.5em; padding:0; }
  .art__li{ position:relative; padding-left:22px; font-size:16.5px; line-height:1.6; color:var(--me-muted); margin-bottom:.9em; }
  .art__li::before{ content:''; position:absolute; left:4px; top:.62em; width:6px; height:6px; border-radius:50%; background:var(--me-accent); }

  .art__fig{ margin:clamp(32px,5vh,52px) 0; }
  .art__fig-img{ width:100%; height:auto; display:block; border-radius:12px; border:1px solid var(--me-line); }
  .art__fig-cap{ margin-top:12px; font-family:var(--font-ui); font-size:13px; color:var(--me-faint); }

  .art__links{ margin:clamp(28px,4vh,44px) 0; border-top:1px solid var(--me-line); }
  .art__link{ display:grid; grid-template-columns:120px 1fr auto; align-items:baseline; gap:16px; padding:16px 0; border-bottom:1px solid var(--me-line); }
  .art__link:hover .art__link-val{ color:var(--me-accent); }
  .art__link-label{ font-family:var(--font-ui); font-size:12px; text-transform:uppercase; letter-spacing:.03em; color:var(--me-faint); }
  .art__link-val{ font-family:var(--font-ui); font-size:15px; color:var(--me-ink); overflow-wrap:anywhere; }
  .art__link-arr{ color:var(--me-accent); }

  .art__note{ margin-top:clamp(32px,5vh,48px); padding-top:22px; border-top:1px solid var(--me-line); font-size:14.5px; font-style:italic; color:var(--me-muted); }
  .art__div{ margin:clamp(30px,5vh,48px) 0; text-align:center; }
  .art__div span{ color:var(--me-accent-2); font-weight:700; font-size:26px; }
  .art__signoff{ margin:clamp(40px,7vh,80px) 0 0; font-family:var(--font-ui); font-size:clamp(26px,4vw,42px); font-weight:800; letter-spacing:-.03em; line-height:1.05; color:var(--me-ink-strong); }

  .art__foot{ margin-top:clamp(48px,8vh,90px); padding-top:22px; border-top:1px solid var(--me-line); display:flex; align-items:center; justify-content:space-between; gap:20px; }
  .art__share{ display:flex; gap:18px; font-family:var(--font-ui); font-size:13px; }
  .art__share a{ color:var(--me-muted); }
  .art__share a:hover{ color:var(--me-accent); }

  @media (max-width:560px){
    .art__link{ grid-template-columns:1fr auto; }
    .art__link-label{ display:none; }
  }
  @media (prefers-reduced-motion: reduce){ .art-progress{ display:none; } }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bar = document.getElementById('artProgress');
  if (bar && !reduce) {
    const upd = () => {
      const el = document.documentElement;
      const max = el.scrollHeight - el.clientHeight;
      bar.style.width = (max > 0 ? (el.scrollTop / max) * 100 : 0) + '%';
    };
    addEventListener('scroll', upd, { passive: true });
    addEventListener('resize', upd, { passive: true });
    upd();
  } else if (bar) { bar.style.display = 'none'; }
</script>
