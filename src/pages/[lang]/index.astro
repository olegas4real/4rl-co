---
// Localized personal homes: /pt/ /es/ /zh/ /ru/. Same component as the root,
// zero duplication — Me and PersonalHome self-localize from Astro.currentLocale.
import Me from '../../layouts/Me.astro';
import PersonalHome from '../../components/PersonalHome.astro';

export function getStaticPaths() {
  return ['en', 'es', 'zh', 'ru'].map((lang) => ({ params: { lang } }));
}
---
<Me>
  <PersonalHome />
</Me>
