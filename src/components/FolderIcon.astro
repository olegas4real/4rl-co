---
// Glossy folder in the reference style: soft gradient body, wide tab, a thin
// white line-icon centred on the flap, a star badge top-right. Recolours from a
// single base hex; the flap lifts on hover and morphs into the window on click
// (that part lives in PersonalHome). Drawn as inline SVG — CSP-safe, crisp.
const { color = '#4AA3F0', icon = '', uid = '0', star = true } = Astro.props;

function shade(hex, p) {
  const n = parseInt(hex.slice(1), 16);
  let r = (n >> 16) & 255, g = (n >> 8) & 255, b = n & 255;
  const t = p < 0 ? 0 : 255, a = Math.abs(p);
  r = Math.round((t - r) * a + r);
  g = Math.round((t - g) * a + g);
  b = Math.round((t - b) * a + b);
  return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
}

const bodyTop = shade(color, 0.16);
const bodyBot = shade(color, -0.12);
const backCol = shade(color, -0.24);
const bId = `fb-${uid}`, gId = `fg-${uid}`;

// Thin line icons in a 24×24 box (stroke, no fill).
const ICONS = {
  person: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6',
  signal: 'M12 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3M8 8a5.5 5.5 0 0 0 0 8M16 8a5.5 5.5 0 0 1 0 8M5 5a9.5 9.5 0 0 0 0 14M19 5a9.5 9.5 0 0 1 0 14',
  book: 'M12 6c-2-1.4-5-1.4-7 0v12c2-1.4 5-1.4 7 0m0-12c2-1.4 5-1.4 7 0v12c-2-1.4-5-1.4-7 0m0-12v12',
  flask: 'M9 3h6M10 3v6.2l-4.6 7.6A2 2 0 0 0 7.1 20h9.8a2 2 0 0 0 1.7-3.2L14 9.2V3M7.8 15h8.4',
  chart: 'M6 20v-5M12 20V9M18 20v-8M4 20h16',
  pen: 'M4 20l1.2-4.2L16 5l3 3L8.2 18.8 4 20M14.5 6.5l3 3',
  activity: 'M3 12h4l2.5-7 4 14 2.5-7H21',
  mail: 'M3.5 6.5A1.5 1.5 0 0 1 5 5h14a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5zM4 6.5l8 6 8-6',
};
const d = ICONS[icon] || '';
---
<svg class="fld" viewBox="0 0 100 82" width="100%" height="100%" aria-hidden="true">
  <defs>
    <linearGradient id={bId} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={bodyTop} />
      <stop offset="1" stop-color={bodyBot} />
    </linearGradient>
    <linearGradient id={gId} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.34" />
      <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.05" />
      <stop offset="0.5" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
  </defs>

  <rect x="8" y="8" width="40" height="16" rx="7" fill={backCol} />
  <rect x="4" y="15" width="92" height="63" rx="13" fill={backCol} />

  <g class="fld__flap">
    <rect x="4" y="24" width="92" height="54" rx="13" fill={`url(#${bId})`} />
    <rect x="4" y="24" width="92" height="54" rx="13" fill={`url(#${gId})`} />
    {d && (
      <g transform="translate(37 38) scale(1.08)" fill="none" stroke="#ffffff" stroke-opacity="0.94" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d={d} />
      </g>
    )}
    {star && (
      <path class="fld__star" transform="translate(78 32) scale(0.42)"
        d="M12 2 l2.9 6.2 6.8.8 -5 4.6 1.3 6.7 -6-3.3 -6 3.3 1.3-6.7 -5-4.6 6.8-.8 z"
        fill="#ffffff" fill-opacity="0.92" />
    )}
  </g>
</svg>

<style>
  .fld{ display:block; overflow:visible; }
  .fld__flap{
    transform-box:fill-box; transform-origin:center bottom;
    transition:transform .28s cubic-bezier(.22,1,.36,1);
  }
  .fld__star{ filter:drop-shadow(0 1px 1px rgba(0,0,0,.2)); }
  @media (prefers-reduced-motion: reduce){ .fld__flap{ transition:none; } }
</style>
